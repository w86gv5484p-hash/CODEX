rules_version = '2';
// 家族スケジュール用のルール。
// ・アプリを開いた端末は匿名ログインします（家族はアカウント作成不要）。
// ・予定は families/{家族コード}/events に保存されます。家族コードを知っている端末だけが読み書きできます。
// ・families の一覧取得は禁止なので、他の家族のコードを探すことはできません。
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{family}/events/{eventId} {
      allow read: if request.auth != null && family.size() >= 12;
      allow create, update: if request.auth != null && family.size() >= 12
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.date is string;
      allow delete: if request.auth != null && family.size() >= 12;
    }
  }
}
