  "history": [
    {
      "date": "1984年",
      "title": "開発スタート",
      "text": "「新しい時代のスポーツカー」を目標に開発が始まる。同年のトリノショーで、ピニンファリーナとの共同研究車 HP-X（ミッドシップのコンセプトカー）が公開された。"
    },
    {
      "date": "1989年2月",
      "title": "プロトタイプ「NS-X」発表",
      "text": "シカゴ・オートショーで試作車を公開。New Sportscar eXperimental を意味する名称。"
    },
    {
      "date": "1990年9月",
      "title": "NSX 発売",
      "text": "国内でNSX、北米ではアキュラ NSXとして販売開始。価格は5MT 800万円台。高根沢の専用工場で熟練工がほぼ手作業で組み立てた。",
      "img": "museum-red"
    },
    {
      "date": "1991年",
      "title": "あなたの年式",
      "text": "初期型（NA1）。のちに「タイプI」とも呼ばれる、リトラクタブルライト・3.0L・5MT/4ATの原点となる仕様。",
      "img": "front-1991"
    },
    {
      "date": "1992年11月",
      "title": "NSX タイプR 登場",
      "text": "約120kgの軽量化と専用チューニングを施したサーキット志向モデル。のちのタイプR系の始まり。"
    },
    {
      "date": "1993年",
      "title": "リフレッシュプラン開始",
      "text": "高根沢でオーナー車を新車に近い状態へ戻すメーカー公式プログラムを開始。",
      "img": "museum-rear"
    },
    {
      "date": "1995年3月",
      "title": "タイプT（タルガトップ）追加",
      "text": "脱着式ルーフのタイプTを追加。AT車にはFマチックを採用。"
    },
    {
      "date": "1997年2月",
      "title": "3.2L（NA2）・6MT化",
      "text": "MT車のエンジンを3.2L C32Bに拡大し6速MTを採用。型式はNA2に。"
    },
    {
      "date": "2001年12月",
      "title": "固定式ヘッドライトへ",
      "text": "大幅マイナーチェンジでリトラクタブルライトを廃止。"
    },
    {
      "date": "2002年5月",
      "title": "NSX-R（2代目）",
      "text": "空力とカーボン部品を見直したNSX-Rを発売。"
    },
