  "development": {
    "concept": [
      {
        "title": "人間中心のスーパースポーツ",
        "text": "速さだけでなく、視界の良さ、乗り降りのしやすさ、日常で使える快適性を重視。F-16戦闘機のキャノピーを参考にした低く広いガラスエリアで前方視界を確保した。",
        "img": "cockpit"
      },
      {
        "title": "オールアルミボディ",
        "text": "量産車として世界初のオールアルミ・モノコック。スチール比で大幅な軽量化を実現し、ミッドシップのバランスを活かした。",
        "img": "countryside"
      },
      {
        "title": "F1技術のフィードバック",
        "text": "当時ホンダはF1でエンジンサプライヤーとして黄金期。チタンコンロッドやVTECなど、高回転・高耐久の技術を市販車に投入した。",
        "img": "engine"
      },
      {
        "title": "ニュルブルクリンクと鈴鹿",
        "text": "ドイツ・ニュルブルクリンクで長期間走り込み、ボディ剛性とハンドリングを熟成させた。",
        "img": "road-red"
      }
    ],
    "people": [
      {
        "name": "上原 繁（うえはら しげる）",
        "role": "開発責任者",
        "text": "ホンダの車両運動性能の研究出身。NSXの開発を率い、ハンドリングと日常性の両立をまとめ上げた。のちにNSXタイプRやS2000の開発も指揮した。"
      },
      {
        "name": "アイルトン・セナ",
        "role": "テスト・評価",
        "text": "当時マクラーレン・ホンダのF1ドライバー。鈴鹿での試作車テストでボディ剛性の不足を指摘し、量産前の剛性向上につながったとされる。"
      },
      {
        "name": "中嶋 悟",
        "role": "テスト・評価",
        "text": "日本人初のフルタイムF1ドライバー。開発テストに参加し、シャシーセッティングの評価に関わった。"
      }
    ],
    "note": "開発の経緯は当時の発表資料、ホンダ公式の回顧記事、関係者インタビューで伝えられている内容をまとめています。"
